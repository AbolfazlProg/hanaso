# HANASO web — environment variable NAMES (non-secret samples only).
# Real values never live in git. Local dev needs none of these — without DATABASE_URL
# the app runs on the in-memory DEV-ONLY repositories (exactly like before M0-10).

# Non-secret, safe to expose to the client:
NEXT_PUBLIC_ENV=local
NEXT_PUBLIC_APP_VERSION=dev
NEXT_PUBLIC_BUILD_SHA=dev

# --- M0-10 database layer ---
# Set DATABASE_URL to switch the repositories onto PostgreSQL 18 (app + /api/ready).
# Production points at PgBouncer (transaction mode, scram); local dev can point
# straight at a postgres instance. Integration tests use TEST_DATABASE_URL instead.
# DATABASE_URL=postgresql://hanaso:CHANGE_ME@localhost:5432/hanaso
# Direct (non-PgBouncer) URL — migrations/seed/backup/restore only (falls back to DATABASE_URL):
# DIRECT_DATABASE_URL=postgresql://hanaso:CHANGE_ME@localhost:5432/hanaso
# TEST_DATABASE_URL=postgresql://hanaso:CHANGE_ME@localhost:5432/postgres
# DB_POOL_MAX=8

# --- M1 (auth) ---
# BETTER_AUTH_SECRET=CHANGE_ME

# --- TASK-HANASO-24: session tokens (signed hanaso_lid) ---
# REQUIRED in production (the app refuses to boot without it). Generate with:
#   openssl rand -hex 32
# HANASO_SESSION_SECRET=CHANGE_ME_64_HEX_CHARS
# Bounds the pre-24 raw-cookie -> signed-token re-issue grace. Recommended at
# deploy time: NOW + 14 days (existing learners keep their progress linked;
# after the date raw values are never re-signed — fail-closed). ISO-8601:
# HANASO_LEGACY_TOKEN_CUTOFF=2026-12-01T00:00:00Z
