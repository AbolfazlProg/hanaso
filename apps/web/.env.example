# HANASO web — environment variable NAMES (non-secret samples only).
# Real values never live in git. Local dev needs none of these (skeleton has no DB).

# Non-secret, safe to expose to the client:
NEXT_PUBLIC_ENV=local
NEXT_PUBLIC_APP_VERSION=dev
NEXT_PUBLIC_BUILD_SHA=dev

