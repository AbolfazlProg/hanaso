# HANASO preview env — NAMES with non-secret placeholder values.
# Copy to /opt/hanaso/.env on the VPS and adjust. NEVER commit real values.

# Image tag: a git commit SHA (immutable) — set by deploy.sh, or fixed here for manual runs
HANASO_WEB_IMAGE=ghcr.io/abolfazlprog/hanaso:<SHA>

# Non-secret public build identity — MUST match the deployed SHA
# (VPS↔GitHub coherence ADR-015; /api/health reports these):
# NOTE: NEXT_PUBLIC_* are baked at BUILD time by CI; the GHCR image reports env=production.
# This runtime value is informational only (dedicated-host compose).
NEXT_PUBLIC_ENV=staging
NEXT_PUBLIC_APP_VERSION=2026.11.0
# NEXT_PUBLIC_BUILD_SHA=<same SHA as HANASO_WEB_IMAGE>

# --- M0-10 database layer (shared-VPS compose: postgres + pgbouncer + worker) ---
# Postgres instance (docker-network only — never published):
POSTGRES_USER=hanaso
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=hanaso

# NOTE (review r2/S3 — single source of truth): DATABASE_URL /
# DIRECT_DATABASE_URL are INTERPOLATED by docker-compose.shared-vps.yml from the
# three POSTGRES_* values above — do NOT hand-write them in .env. Keeping two
# copies of the password here desynchronized web from worker/migrate.
# Direct (non-PgBouncer) URL is used by migrate/seed/backup/restore only.

# App pool size through PgBouncer (default 8 — small shared VPS):
# DB_POOL_MAX=8
