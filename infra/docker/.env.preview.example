# HANASO preview env — NAMES with non-secret placeholder values.
# Copy to repo-root .env on the VPS and adjust. NEVER commit real values.

# Image tag: a git commit SHA (immutable) — set by deploy.sh, or fixed here for manual runs
HANASO_WEB_IMAGE=ghcr.io/abolfazlprog/hanaso:<SHA>

# Non-secret public build identity — MUST match the deployed SHA
# (VPS↔GitHub coherence ADR-015; /api/health reports these):
NEXT_PUBLIC_ENV=staging
NEXT_PUBLIC_APP_VERSION=2026.11.0
# NEXT_PUBLIC_BUILD_SHA=<same SHA as HANASO_WEB_IMAGE>

# From M0-10 (not used by the skeleton):
# DATABASE_URL=postgresql://hanaso:CHANGE_ME@postgres:5432/hanaso
