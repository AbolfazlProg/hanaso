#!/usr/bin/env bash
# curl — simulation stub for the update-hanaso.sh sandbox tests.
# Serves canned JSON/HTML for /api/health, /api/ready, / and the KOTODAMA
# witness from the simulation state (set by the docker stub on `compose up`).
SIM="${HANASO_SIM_DIR:?set HANASO_SIM_DIR}"
[ -f "${SIM}/config.env" ] && . "${SIM}/config.env"
[ -f "${SIM}/state.env" ] && . "${SIM}/state.env"

url=""; out=""; wfmt=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    -w) wfmt="$2"; shift 2 ;;
    -m) shift 2 ;;
    -[a-zA-Z]*) shift ;;
    http://*|https://*) url="$1"; shift ;;
    *) shift ;;
  esac
done

body() {
  case "${url}" in
    */api/health)
      if [ "${SIM_HEALTH_OK:-1}" != 1 ]; then
        echo '{"ok":false,"status":"degraded"}'; return 9
      fi
      printf '{"ok":true,"status":"ok","service":"hanaso-web","version":"%s","commit":"%s","env":"production"}\n' \
        "${CURRENT_VERSION:-?}" "${CURRENT_COMMIT:-?}"
      ;;
    */api/ready)
      if [ "${SIM_READY_DB_FAIL:-0}" = 1 ]; then
        echo '{"ok":false,"checks":{"database":{"status":"down"}}}'; return 9
      fi
      printf '{"ok":true,"service":"hanaso-web","checks":{"process":{"status":"ok"},"database":{"status":"ok","serverVersion":"18.6"}}}\n'
      ;;
    https://kotodama.ir*|http://kotodama.ir*|https://www.kotodama.ir*|http://www.kotodama.ir*)
      code="$([ "${PHASE:-before}" = updated ] && echo "${SIM_KOTODAMA_AFTER:-200}" || echo "${SIM_KOTODAMA_BEFORE:-200}")"
      echo "__HTTP_CODE__${code}"; return 0
      ;;
    */|*)
      printf '<!doctype html><html dir="rtl" lang="ja"><body>sim</body></html>\n'
      ;;
  esac
}

b="$(body)"; rc=$?
if echo "$b" | grep -q '__HTTP_CODE__'; then
  code="${b#__HTTP_CODE__}"
  if [ -n "${out}" ]; then : > "${out}"; fi
  if echo "${wfmt}" | grep -q 'http_code'; then printf '%s\n' "${code}"; fi
  exit 0
fi
if [ "${rc}" != 0 ]; then exit "${rc}"; fi
if [ -n "${out}" ]; then printf '%s\n' "$b" > "${out}"; else printf '%s\n' "$b"; fi
if echo "${wfmt}" | grep -q 'http_code'; then printf '200\n'; fi
exit 0
